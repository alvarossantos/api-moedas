PORT=9000
API_KEY_EXCHANGE=your_api_key_here

# ── IA — Provedor ativo ──────────────────────────
# Opções: openai | gemini | openrouter
AI_PROVIDER=openrouter

# ── IA — Modelo (opcional, sobrescreve o padrão do provedor) ──
# AI_MODEL=inclusionai/ling-3.0-flash:free

# ── IA — Chaves de API (configure apenas o provedor ativo) ──
# OpenAI:    https://platform.openai.com/api-keys
# Gemini:    https://aistudio.google.com/apikey
# OpenRouter: https://openrouter.ai/keys
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
